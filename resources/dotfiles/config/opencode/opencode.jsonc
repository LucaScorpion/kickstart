{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "permission": {
    "*": "ask",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "skill": "allow",
    "task": "allow",
    "todowrite": "allow",
    "list": "allow",
    "bash": {
      // General
      "cp *": "allow",
      "date *": "allow",
      "echo *": "allow",
      "find *": "ask", // Find can execute code with `-exec`.
      "grep *": "allow",
      "head *": "allow",
      "ls *": "allow",
      "mkdir *": "allow",
      "mv *": "allow",
      "rm *": "allow",
      "sort *": "allow",
      "tail": "allow",
      "true": "allow",
      "wc *": "allow",
      // gh
      "gh pr checkout *": "allow",
      "gh pr create *": "allow",
      "gh pr diff *": "allow",
      "gh pr list *": "allow",
      "gh pr view *": "allow",
      // Git
      "git add *": "allow",
      "git branch --show-current": "allow",
      "git commit *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git push": "allow", // Specifically without arguments.
      "git status *": "allow",
      "git switch *": "allow",
      // pnpm
      "pnpm add *": "ask",
      "pnpm dlx *": "ask",
      "pnpm i *": "ask",
      "pnpm install *": "ask",
      "pnpm *": "allow"
    }
  },
  "model": "qwen/qwen3.6-35b-a3b",
  "small_model": "google/gemma-4-e4b",
  "provider": {
    "open-webui": {
      // Run `/connect` with "Other Custom Provider" to configure the API key, name "open-webui".
      "npm": "@ai-sdk/openai-compatible",
      "name": "Open WebUI (local)",
      "options": {
        "baseURL": "https://ai.scalzotto.nl/api"
      },
      "models": {
        "qwen/qwen3-coder-next": {
          "name": "Qwen3 Coder Next",
          "limit": {
            "context": 262144,
            "output": 65536
          }
        },
        "qwen/qwen3.6-35b-a3b": {
          "name": "Qwen3.6",
          "limit": {
            "context": 262144,
            "output": 65536
          }
        },
        "qwen/qwen3.6-27b": {
          "name": "Qwen3.6 Dense",
          "limit": {
            "context": 262144,
            "output": 65536
          }
        },
        "google/gemma-4-e4b": {
          "name": "Gemma 4",
          "limit": {
            "context": 131072,
            "output": 65536
          }
        }
      }
    }
  }
}
