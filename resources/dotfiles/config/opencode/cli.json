{
  "$schema": "https://opencode.ai/v2/cli.json",
  "cursor": {
    "style": "line"
  },
  "tabs": {
    "mode": "off"
  },
  "terminal": {
    "copy": "manual"
  },
  "keybinds": {
    "input.line.home": ["ctrl+a", "home"],
    "input.line.end": ["ctrl+e", "end"],
    "session.first": ["ctrl+g"],
    "session.last": ["ctrl+alt+g"]
  }
}
